########################################
# E-Waste Detection Project - .gitignore
########################################

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# ---- Virtual environments ----
venv/
env/
ENV/
.venv/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

########################################
# Project data - DO NOT COMMIT
# These folders hold raw photos, generated
# synthetic images, and cut-outs. They are
# large, binary, and easy to regenerate from
# the scripts - git is the wrong place for them.
########################################
raw/
cutouts/
dataset/
real_test/

# if you want to keep the folder structure visible in the repo,
# create empty raw/ewaste/.gitkeep, raw/organic/.gitkeep, etc.
# and un-ignore just those with the lines below:
# !raw/**/.gitkeep
# !cutouts/**/.gitkeep

########################################
# YOLO / Ultralytics training outputs
# These include model weights (100MB+ each),
# hundreds of result images, and logs per run.
########################################
runs/
*.pt
*.onnx
*.engine
*.torchscript
*.pb
*.tflite
wandb/

########################################
# Misc large / generated files
########################################
*.zip
*.tar
*.tar.gz
*.log
*.csv.bak

# model cache used by rembg (background removal models, ~100-200MB each)
.u2net/

# ---- generated pipeline outputs (all reproducible from the scripts) ----
# Kept out of git deliberately: these are regenerated by 01..08 from the
# manifests in splits/, which ARE tracked. Tracking them once pushed .git
# past half a gigabyte while leaving the source scripts untracked.
dataset_pool*/
cutouts/
backgrounds/
runs/
eval_pool*/
logs/

# ---- source photograph collections ----
# raw/ is the hand-curated e-waste pool; assets/ is the 7.7 GB TrashBox +
# RealWaste download. Both come from their own upstream sources and are
# referenced by relative path from splits/*.csv, which is what makes the
# partition reproducible without redistributing the imagery.
raw/
assets/

# ---- third-party checkouts and their virtualenvs ----
external/

# ---- model weights ----
*.pt

# ---- deposit archive (rebuilt by the packaging step) ----
zenodo_deposit.zip

# ---- logs and editor leftovers ----
*.log
*.bak
